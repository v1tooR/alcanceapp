# Front-end → Supabase. Gere o .env.local com `npm run env:setup`.
#
# Variáveis VITE_* são embutidas no build: depois de mudar uma delas na
# hospedagem (ex.: Vercel), faça um novo deploy.

# URL pública da API do Supabase (Kong). Local: http://localhost:8000
VITE_SUPABASE_URL=http://localhost:8000

# Chave anônima (ANON_KEY do docker/.env). É pública por natureza: quem protege
# os dados é a RLS. NUNCA coloque a SERVICE_ROLE_KEY aqui.
VITE_SUPABASE_ANON_KEY=
