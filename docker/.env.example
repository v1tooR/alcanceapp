############################################################################
# Ambiente Supabase self-hosted da Alcance Isenções
#
# NÃO copie este arquivo à mão: rode `npm run env:setup` na raiz do projeto.
# O script gera docker/.env com segredos aleatórios e .env.local para o front.
# Os valores abaixo são apenas marcadores e NÃO funcionam como estão.
#
# docker/.env e .env.local ficam fora do git (.gitignore).
############################################################################

############
# Segredos — gerados por `npm run env:setup`
############

# Senha do Postgres (também usada pelos papéis internos do Supabase).
POSTGRES_PASSWORD=gerar

# Segredo HS256 que assina os JWTs (mín. 32 caracteres).
JWT_SECRET=gerar
# Chaves de API: JWTs assinados com JWT_SECRET.
#   ANON_KEY vai para o front (pública por natureza; a RLS protege os dados).
#   SERVICE_ROLE_KEY ignora a RLS: só em servidor, NUNCA no front.
ANON_KEY=gerar
SERVICE_ROLE_KEY=gerar

# Login do Studio (painel do Supabase) em http://localhost:8000
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=gerar

# Chave de sessão do Realtime (mín. 64 caracteres).
SECRET_KEY_BASE=gerar
# Chave de criptografia do Realtime — EXATAMENTE 16 caracteres (AES-128).
# Com outro tamanho o Realtime sobe, mas falha em silêncio.
REALTIME_ENC_KEY=gerar
# Criptografia das conexões Studio → postgres-meta (mín. 32 caracteres).
PG_META_CRYPTO_KEY=gerar

############
# URLs e portas
############

# Endereço público da API (Kong).
SUPABASE_PUBLIC_URL=http://localhost:8000
KONG_HTTP_PORT=8000
# Porta do Postgres no host (54322 para não colidir com um Postgres local).
POSTGRES_PORT=54322

# Endereço do front — base dos links de convite e recuperação de senha.
SITE_URL=http://localhost:5173
# Outras origens autorizadas a receber redirecionamento do Auth (vírgula).
ADDITIONAL_REDIRECT_URLS=http://localhost:5173/**,http://localhost:4173/**

# Validade do JWT de acesso, em segundos.
JWT_EXPIRY=3600

############
# Integração "email" — SMTP usado pelo Auth (convites e recuperação de senha)
# Em desenvolvimento, o Mailpit captura tudo: http://localhost:8025
############
SMTP_ADMIN_EMAIL=nao-responda@alcanceisencoes.com.br
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
# Segredo: em produção, a senha do provedor SMTP.
SMTP_PASS=
SMTP_SENDER_NAME=Alcance Isenções
MAILPIT_UI_PORT=8025

############
# Integração "antivirus" (opcional) — docker compose --profile antivirus up -d
############
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

############
# Seed
############

# demo = produção + dados de demonstração · prod = só o mínimo · none = vazio
SEED_MODE=demo

# Administrador inicial criado pelo seed de produção.
ADMIN_EMAIL=admin@alcanceisencoes.com.br
ADMIN_NAME=Administração Alcance
# Senha inicial do administrador — troque no primeiro acesso.
ADMIN_INITIAL_PASSWORD=gerar

# Senha de todas as contas de demonstração (apenas SEED_MODE=demo).
DEMO_PASSWORD=alcance2026
