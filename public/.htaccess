# Hostinger (Apache/LiteSpeed) — app.alcanceisencoes.com.br
# Vai junto no build (pasta public/ → dist/). Envie o CONTEÚDO de dist/ para a
# pasta do subdomínio no Gerenciador de Arquivos.

Options -Indexes

# Arquivos ocultos (.env, .git...) nunca são servidos, mesmo se enviados por engano.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Sempre HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # App de página única: rotas como /app/processos devolvem o index.html
  # (sem isto, recarregar a página dá 404).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Só código do próprio domínio; conexões só com o Supabase do projeto.
  # Ao trocar de projeto Supabase, troque o endereço em connect-src.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://ymqkpfpmbktyalxnrkmx.supabase.co wss://ymqkpfpmbktyalxnrkmx.supabase.co; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  # Arquivos com hash no nome (assets/) podem ficar em cache por 1 ano.
  <FilesMatch "\.(js|css|woff2|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Vem DEPOIS da regra acima para vencer: index.html e o service worker nunca
  # ficam em cache, senão um deploy novo não chega a quem já abriu o app.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
